{
  "name": "quinchool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,api,ai -c cyan,magenta,yellow \"npm run dev:web\" \"npm run dev:api\" \"npm run dev:ai\"",
    "dev:web": "cd apps/web && npm run dev",
    "dev:api": "cd apps/api && npm run dev",
    "dev:ai": "cd apps/ai && .venv\\Scripts\\python -m uvicorn app.main:app --reload --port 8000",
    "build": "cd apps/web && npm run build && cd ../api && npm run build",
    "lint": "cd apps/web && npm run lint",
    "lint:tailwind": "cd apps/web && npm run lint:tailwind",
    "test:tailwind": "cd apps/web && npm run test:tailwind",
    "install:all": "cd apps/web && npm install && cd ../api && npm install",
    "infra": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
