// Prisma schema. Models are defined per feature.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

// better-auth core schema for the email + password setup
// (user, session, account, verification).

model User {
  id               String            @id @default(cuid())
  name             String
  email            String            @unique
  emailVerified    Boolean           @default(false)
  image            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions         Session[]
  accounts         Account[]
  careerProfile    CareerProfile?
  jobScraperConfig JobScraperConfig?
  scrapedJobs      ScrapedJob[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// Career Profile: the complete source data used to tailor a user's resume.

model CareerProfile {
  id              String       @id @default(cuid())
  name            String
  email           String
  contactNumber   String
  linkedin        String?
  github          String?
  personalWebsite String?
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  experiences     Experience[]
  projects        Project[]
  skillGroups     SkillGroup[]
  educations      Education[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("career_profile")
}

model Experience {
  id              String             @id @default(cuid())
  jobTitle        String
  companyName     String
  location        String
  employmentType  String?
  isCurrent       Boolean            @default(false)
  startDate       DateTime           @db.Date
  endDate         DateTime?          @db.Date
  sortOrder       Int                @default(0)
  careerProfileId String
  careerProfile   CareerProfile      @relation(fields: [careerProfileId], references: [id], onDelete: Cascade)
  bullets         ExperienceBullet[]
  skills          Skill[]            @relation("ExperienceSkills")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([careerProfileId, sortOrder])
  @@map("experience")
}

model ExperienceBullet {
  id           String     @id @default(cuid())
  text         String
  sortOrder    Int        @default(0)
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([experienceId, sortOrder])
  @@map("experience_bullet")
}

model Project {
  id              String          @id @default(cuid())
  projectName     String
  isCurrent       Boolean         @default(false)
  startDate       DateTime        @db.Date
  endDate         DateTime?       @db.Date
  sortOrder       Int             @default(0)
  careerProfileId String
  careerProfile   CareerProfile   @relation(fields: [careerProfileId], references: [id], onDelete: Cascade)
  bullets         ProjectBullet[]
  skills          Skill[]         @relation("ProjectSkills")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([careerProfileId, sortOrder])
  @@map("project")
}

model ProjectBullet {
  id        String   @id @default(cuid())
  text      String
  sortOrder Int      @default(0)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, sortOrder])
  @@map("project_bullet")
}

model SkillGroup {
  id              String        @id @default(cuid())
  label           String
  sortOrder       Int           @default(0)
  careerProfileId String
  careerProfile   CareerProfile @relation(fields: [careerProfileId], references: [id], onDelete: Cascade)
  skills          Skill[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([careerProfileId, sortOrder])
  @@map("skill_group")
}

model Skill {
  id           String       @id @default(cuid())
  name         String
  sortOrder    Int          @default(0)
  skillGroupId String
  skillGroup   SkillGroup   @relation(fields: [skillGroupId], references: [id], onDelete: Cascade)
  experiences  Experience[] @relation("ExperienceSkills")
  projects     Project[]    @relation("ProjectSkills")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([skillGroupId, name])
  @@index([skillGroupId, sortOrder])
  @@map("skill")
}

model Education {
  id              String        @id @default(cuid())
  institutionName String
  location        String
  degree          String
  fieldOfStudy    String
  specialization  String?
  startDate       DateTime      @db.Date
  endDate         DateTime      @db.Date
  sortOrder       Int           @default(0)
  careerProfileId String
  careerProfile   CareerProfile @relation(fields: [careerProfileId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([careerProfileId, sortOrder])
  @@map("education")
}

model JobScraperConfig {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles                String[]
  includedLevels       String[]
  requiredTechnologies String[]
  excludedLevels       String[]
  excludedTechnologies String[]
  sources              String[]
  timeRange            String
  customStartDate      DateTime? @db.Date
  customEndDate        DateTime? @db.Date
  worldwideWorkModes   String[]
  philippinesWorkModes String[]
  lastScannedAt        DateTime?
  lastScanId           String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("job_scraper_config")
}

model ScrapedJob {
  id                     String    @id @default(cuid())
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  source                 String
  sourceJobId            String
  url                    String
  title                  String
  company                String
  location               String
  country                String
  workMode               String
  level                  String
  classification         String
  isManualClassification Boolean   @default(false)
  postedDate             DateTime? @db.Date
  postedAt               DateTime? @db.Timestamptz(3)
  postedText             String?
  summary                String
  description            String
  matchedSkills          String[]
  reviewReasons          String[]
  firstSeenAt            DateTime  @default(now())
  lastSeenAt             DateTime  @default(now())
  firstSeenScanId        String
  lastSeenScanId         String

  @@unique([userId, source, sourceJobId])
  @@index([userId, lastSeenAt])
  @@index([userId, classification, lastSeenAt])
  @@map("scraped_job")
}
